#!/bin/sh
set -e
ROOT=${DPKG_ROOT:-}
MOTD=$ROOT/etc/motd
BACKUP=$ROOT/etc/motd.pre-orac

# Undo the login-message takeover, but only if /etc/motd is still ORAC's link.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -L "$MOTD" ] && [ "$(readlink "$MOTD")" = /usr/share/orac/motd ]; then
        if [ -e "$BACKUP" ]; then
            mv "$BACKUP" "$MOTD"
        else
            rm -f "$MOTD"
        fi
    fi
fi

# Give /etc/issue and /etc/issue.net back to base-files: drop ORAC's link, then undo the diversion.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    for f in issue issue.net; do
        if [ "$(dpkg-divert --listpackage "/etc/$f" 2>/dev/null || true)" = orac-branding ]; then
            if [ -L "$ROOT/etc/$f" ]; then rm -f "$ROOT/etc/$f"; fi
            dpkg-divert --package orac-branding --quiet --rename --remove "/etc/$f"
        fi
    done
fi
exit 0
