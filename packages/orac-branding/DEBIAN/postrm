#!/bin/sh
set -e
ROOT=${DPKG_ROOT:-}
MOTD=$ROOT/etc/motd
BACKUP=$ROOT/etc/motd.pre-orac

# Undo the login-message takeover, but only if /etc/motd is still ORAC's link.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -L "$MOTD" ] && [ "$(readlink "$MOTD")" = /usr/share/orac/motd ]; then
        if [ -e "$BACKUP" ]; then
            mv "$BACKUP" "$MOTD"
        else
            rm -f "$MOTD"
        fi
    fi
fi
exit 0
