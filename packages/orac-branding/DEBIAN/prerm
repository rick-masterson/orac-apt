#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
    if [ -z "${DPKG_ROOT:-}" ] && command -v plymouth-set-default-theme >/dev/null 2>&1 \
        && [ "$(plymouth-set-default-theme)" = orac ]; then
        echo "orac-branding: ORAC is the active boot splash; switch back first:" >&2
        echo "  sudo plymouth-set-default-theme -R shadowfetch" >&2
    fi
fi
exit 0
