// ORAC terminal banner for fastfetch. Installed by orac-branding; applied per user with
// `orac-terminal-theme apply` (copies this to ~/.config/fastfetch/config.jsonc).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/orac/fastfetch/logo.txt",
        "type": "file",
        "padding": { "top": 1, "right": 3 },
        "color": {
            "1": "38;2;255;122;47",
            "2": "38;2;236;97;102",
            "3": "38;2;203;83;164",
            "4": "38;2;139;92;246",
            "5": "1;38;2;236;230;243",
            "6": "38;2;154;143;171"
        }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;255;122;47", "title": "38;2;224;80;138" }
    },
    "modules": [
        "title", "separator",
        "os", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
        "terminal", "cpu", "gpu", "memory", "swap", "disk",
        "break",
        "colors"
    ]
}
